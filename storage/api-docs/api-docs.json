{
    "openapi": "3.0.0",
    "info": {
        "title": "API EBAC — Églises et niveaux",
        "description": "Documentation OpenAPI des CRUD des églises et des niveaux.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "Serveur courant"
