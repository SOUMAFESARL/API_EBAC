    "components": {
        "schemas": {
            "RepresentantEglise": {
                "required": [
                    "nom"
                ],
                "properties": {
                    "nom": {
                        "type": "string",
                        "example": "Kouassi",
                        "maxLength": 150
                    },
                    "prenoms": {
                        "type": "string",
                        "example": "Jean",
                        "nullable": true,
                        "maxLength": 150
                    },
                    "fonction": {
                        "type": "string",
                        "example": "Secrétaire",
                        "nullable": true,
                        "maxLength": 100
                    },
                    "telephone": {
                        "type": "string",
                        "example": "+2250102030405",
                        "nullable": true,
                        "maxLength": 30
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "jean@example.com",
                        "nullable": true,
                        "maxLength": 150
                    }
                },
                "type": "object"
            },
            "EglisePayload": {
                "required": [
                    "nom",
                    "ville_commune"
                ],
                "properties": {
                    "nom": {
                        "type": "string",
                        "example": "Église Cité de la Grâce",
                        "maxLength": 180
                    },
                    "sigle": {
                        "type": "string",
                        "example": "ECG",
                        "nullable": true,
                        "maxLength": 30
                    },
                    "pasteur_principal": {
                        "type": "string",
                        "example": "Pasteur Yao Thomas",
                        "nullable": true,
                        "maxLength": 180
                    },
                    "denomination": {
                        "type": "string",
                        "example": "Église évangélique",
                        "nullable": true,
                        "maxLength": 180
                    },
                    "adresse": {
                        "type": "string",
                        "example": "Cocody Angré",
                        "nullable": true,
                        "maxLength": 255
                    },
                    "region": {
                        "type": "string",
                        "example": "District autonome d’Abidjan",
                        "nullable": true,
                        "maxLength": 120
                    },
                    "district": {
                        "type": "string",
                        "example": "Abidjan Nord",
                        "nullable": true,
                        "maxLength": 120
                    },
                    "ville_commune": {
                        "type": "string",
                        "example": "Cocody",
                        "maxLength": 120
                    },
                    "telephone": {
                        "type": "string",
                        "example": "+2250102030405",
                        "nullable": true,
                        "maxLength": 30
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "contact@eglise.example",
                        "nullable": true,
                        "maxLength": 150
                    },
                    "statut": {
                        "type": "string",
                        "default": "Active",
                        "enum": [
                            "Active",
                            "Suspendue",
                            "Archivée"
                        ]
                    },
                    "capacite_max_stagiaires": {
                        "type": "integer",
                        "example": 25,
                        "default": 0,
                        "maximum": 65535,
                        "minimum": 0
                    },
                    "representants": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/RepresentantEglise"
                        },
                        "nullable": true
                    },
                    "observations": {
                        "type": "string",
                        "example": "Église partenaire depuis 2026.",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Eglise": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true,
                        "example": 1
                    },
                    "code": {
                        "type": "string",
                        "readOnly": true,
                        "example": "EGL-000001"
                    },
                    "nom": {
                        "type": "string",
                        "example": "Église Cité de la Grâce"
                    },
                    "sigle": {
                        "type": "string",
                        "example": "ECG",
                        "nullable": true
                    },
                    "pasteur_principal": {
                        "type": "string",
                        "example": "Pasteur Yao Thomas",
                        "nullable": true
                    },
                    "denomination": {
                        "type": "string",
                        "nullable": true
                    },
                    "adresse": {
                        "type": "string",
                        "nullable": true
                    },
                    "region": {
                        "type": "string",
